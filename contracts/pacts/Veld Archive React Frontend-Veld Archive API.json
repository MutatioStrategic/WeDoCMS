{
  "consumer": {
    "name": "Veld Archive React Frontend"
  },
  "interactions": [
    {
      "description": "a browser authentication configuration request",
      "request": {
        "method": "GET",
        "path": "/api/auth/config"
      },
      "response": {
        "body": {
          "provider": "supabase",
          "publishableKey": "sb_publishable_contract_test",
          "redirectUrl": "https://archive.example.com",
          "supabaseUrl": "https://tenant.supabase.co"
        },
        "headers": {
          "Content-Type": "application/json",
          "content-type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.publishableKey": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.redirectUrl": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.supabaseUrl": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "content-type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application\\/json(?:;\\s*charset=utf-8)?$"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a frontend health check",
      "request": {
        "method": "GET",
        "path": "/api/health"
      },
      "response": {
        "body": {
          "environment": "test",
          "ok": true,
          "service": "veld-archive-api"
        },
        "headers": {
          "Content-Type": "application/json",
          "content-type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.environment": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "content-type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application\\/json(?:;\\s*charset=utf-8)?$"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request with an invalid bearer token",
      "request": {
        "body": {
          "organizationId": "org-demo"
        },
        "headers": {
          "Authorization": "Bearer consumer-contract-invalid-token",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/auth/exchange"
      },
      "response": {
        "body": {
          "error": "Verified identity token required"
        },
        "headers": {
          "Content-Type": "application/json",
          "content-type": "application/json"
        },
        "matchingRules": {
          "header": {
            "content-type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application\\/json(?:;\\s*charset=utf-8)?$"
                }
              ]
            }
          }
        },
        "status": 401
      }
    },
    {
      "description": "an anonymous browser session request",
      "request": {
        "method": "GET",
        "path": "/api/auth/session"
      },
      "response": {
        "body": {
          "authenticated": false,
          "user": null
        },
        "headers": {
          "Content-Type": "application/json",
          "content-type": "application/json"
        },
        "matchingRules": {
          "header": {
            "content-type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application\\/json(?:;\\s*charset=utf-8)?$"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "an unauthenticated asset creation request",
      "request": {
        "body": {
          "caption": "Contract test context",
          "culturalTags": [
            "South African archive"
          ],
          "description": "A contract test asset",
          "kind": "image",
          "licensePriceCents": null,
          "modelReleaseStatus": "unknown",
          "monetizationModel": "membership",
          "propertyReleaseStatus": "unknown",
          "rightsStatus": "pending",
          "subjectTags": [
            "test"
          ],
          "title": "Contract sample asset"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/assets"
      },
      "response": {
        "body": {
          "error": "Contributor access required"
        },
        "headers": {
          "Content-Type": "application/json",
          "content-type": "application/json"
        },
        "matchingRules": {
          "header": {
            "content-type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application\\/json(?:;\\s*charset=utf-8)?$"
                }
              ]
            }
          }
        },
        "status": 403
      }
    },
    {
      "description": "an unauthenticated notification request",
      "request": {
        "method": "GET",
        "path": "/api/notifications"
      },
      "response": {
        "body": {
          "error": "Authentication required"
        },
        "headers": {
          "Content-Type": "application/json",
          "content-type": "application/json"
        },
        "matchingRules": {
          "header": {
            "content-type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application\\/json(?:;\\s*charset=utf-8)?$"
                }
              ]
            }
          }
        },
        "status": 401
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.2"
    },
    "pactRust": {
      "ffi": "0.5.6",
      "models": "1.3.14"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "Veld Archive API"
  }
}