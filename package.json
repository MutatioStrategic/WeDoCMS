{
  "name": "veld-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "release:check": "node scripts/release-gate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:models": "vitest run src/contracts/schemas.test.ts && npm run test:migrations",
    "test:contracts": "node scripts/run-contract-tests.mjs",
    "test:contracts:openapi": "node scripts/contracts-openapi.mjs",
    "test:contracts:consumer": "node scripts/contracts-consumer.mjs",
    "test:contracts:provider": "node scripts/contracts-provider.mjs",
    "test:a11y": "node scripts/accessibility-check.mjs",
    "test:mobile": "node scripts/mobile-qa.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "test:e2e:ledger": "node scripts/ledger-e2e.mjs",
    "test:e2e:buyer-finance": "node scripts/buyer-finance-e2e.mjs",
    "test:e2e:access": "node scripts/access-entitlements-e2e.mjs",
    "test:auth": "node scripts/authenticated-smoke.mjs",
    "test:demo": "node scripts/demo-screen-smoke.mjs",
    "test:postman": "node scripts/postman-route-sweep.mjs",
    "test:penetration": "node scripts/penetration-smoke.mjs",
    "test:fuzz": "node scripts/fuzz-http.mjs",
    "test:blast-radius": "node scripts/blast-radius-contract.mjs",
    "test:payments": "node scripts/payment-reconciliation-smoke.mjs",
    "test:migrations": "node scripts/migration-smoke.mjs",
    "test:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-backup.ps1",
    "test:dr": "node scripts/dr-restore-smoke.mjs",
    "test:wordpress-plugin": "node scripts/wordpress-plugin-smoke.mjs",
    "test:wordpress-integration": "node scripts/wordpress-integration-smoke.mjs",
    "test:zoho": "node scripts/zoho-integration-smoke.mjs",
    "test:local-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-local-smoke.ps1",
    "test:local-vision": "node scripts/local-vision-smoke.mjs",
    "benchmark:local-vision": "node scripts/benchmark-local-vision.mjs",
    "vision:proxy": "node scripts/local-vision-proxy.mjs",
    "vision:stack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-vision-stack.ps1",
    "seed:demo-media": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seed-demo-media.ps1",
    "seed:paystack-demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seed-paystack-split-demo.ps1",
    "seed:test-library": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seed-test-photo-library.ps1",
    "seed:test-library:remote": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seed-test-photo-library.ps1 -Remote",
    "fetch:test-photo-library": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-test-photo-library.ps1",
    "upload:test-photo-library": "node scripts/upload-test-photo-library.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "npm run build && npm run release:check && node scripts/release-gate.mjs --production && wrangler deploy --env production",
    "worker:deploy:development": "wrangler deploy",
    "worker:deploy:demo": "npm run build:demo && npm run release:check && wrangler deploy --env demo",
    "pages:prepare-redirect": "node scripts/prepare-pages-redirect.mjs",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:metro": "npm --prefix apps/mobile run start:clear",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:doctor": "npm --prefix apps/mobile run doctor",
    "backup:d1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-d1.ps1",
    "chaos:uploads": "node scripts/chaos-upload.mjs"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.24.0",
    "@supabase/supabase-js": "^2.110.1",
    "hono": "^4.7.7",
    "jose": "^6.2.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@pact-foundation/pact": "^17.1.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "newman": "^6.2.2",
    "openapi-enforcer": "^1.23.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.28.0",
    "yaml": "^2.9.0"
  }
}
