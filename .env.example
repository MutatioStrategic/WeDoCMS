VITE_API_BASE_URL=/api
VITE_TURNSTILE_SITEKEY=replace-with-public-sitekey
# Auth0 SPA application (leave unset to use local dev-login during development)
VITE_AUTH0_DOMAIN=replace-with-your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=replace-with-auth0-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.veldarchive.example
# Optional Auth0 Organization ID for a fixed tenant entry point
VITE_AUTH0_ORGANIZATION=replace-with-auth0-organization-id
# Worker secrets/configuration:
# wrangler secret put SESSION_SECRET
# AUTH_JWKS_URL=https://replace-with-your-tenant.eu.auth0.com/.well-known/jwks.json
# AUTH_ISSUER=https://replace-with-your-tenant.eu.auth0.com/
# AUTH_AUDIENCE=https://api.veldarchive.example
# AUTH_ROLES_CLAIM=https://veldarchive.example/roles
# AUTH_ALLOW_ORG_PROVISIONING=false
# TRENDING_SEARCH_MIN_COUNT=3 # application enforces a minimum of 3
# Set only after live production verification:
# EDGE_CONTROLS_ATTESTED_AT=2026-08-16T00:00:00Z
# KEY_ROTATION_ATTESTED_AT=2026-08-16T00:00:00Z
# BACKUP_RESTORE_ATTESTED_AT=2026-08-16T00:00:00Z
# Auth provider self-service portal for email verification, password reset, and MFA.
# AUTH_ACCOUNT_PORTAL_URL=https://your-idp.example/account
# Cloudflare Stream direct uploads (store STREAM_API_TOKEN as a Worker secret).
# STREAM_ACCOUNT_ID=your-cloudflare-account-id
# STREAM_ALLOWED_ORIGINS=https://app.example.com
# Image delivery uses the IMAGES Worker binding configured in wrangler.jsonc.
# wrangler secret put PAYMENT_WEBHOOK_SECRET
# wrangler secret put PAYMENT_TOKEN
# wrangler secret put MEDIA_SCANNER_SECRET
# ALLOWED_ORIGINS=https://app.example.com
# AUTH_ISSUER=https://idp.example.com/
# AUTH_AUDIENCE=veld-archive
# AUTH_ALLOW_ORG_PROVISIONING=false
# PAYMENT_PROVIDER=paystack
# PAYMENT_ENDPOINT=https://api.paystack.co/transaction/initialize
# MEDIA_SCANNER_URL=https://scanner.example.com/scan
# Set as a Worker secret, never in this file:
# wrangler secret put TURNSTILE_SECRET
# Optional provider secrets/configuration:
# wrangler secret put STRIPE_SECRET_KEY
# wrangler secret put PAYFAST_TOKEN
# wrangler secret put ZA_BANK_TOKEN
# wrangler secret put FIRMA_API_TOKEN
# PAYSTACK_PUBLIC_KEY=replace-with-paystack-public-key
# Store the Paystack secret as PAYMENT_TOKEN with `wrangler secret put PAYMENT_TOKEN`.
# ZA_BANK_ENDPOINT=https://your-bank-adapter.example/payouts
# FIRMA_VERIFY_URL=https://your-firma-adapter.example/verify
