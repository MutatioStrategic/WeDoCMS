VITE_API_BASE_URL=/api
VITE_TURNSTILE_SITEKEY=replace-with-public-sitekey
# Auth0 SPA application (leave unset to use local dev-login during development)
VITE_AUTH0_DOMAIN=dev-irn8jgmlsiudjo2l.us.auth0.com
VITE_AUTH0_CLIENT_ID=replace-with-auth0-spa-client-id
# This must be the Identifier of a custom Auth0 API for Veld Archive.
# Do not use https://dev-irn8jgmlsiudjo2l.us.auth0.com/api/v2/ here; that is
# Auth0's Management API audience and must never be exposed to the browser.
VITE_AUTH0_AUDIENCE=https://api.veldarchive.example
# Optional Auth0 Organization ID for a fixed tenant entry point
VITE_AUTH0_ORGANIZATION=replace-with-auth0-organization-id
# Optional Supabase Auth project (can be enabled alongside Auth0)
VITE_SUPABASE_URL=https://replace-with-project.supabase.co
# Prefer the current Supabase publishable key; the legacy anon key remains supported.
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# Public hosted recurring subscription checkout. The plan code is not a secret.
VITE_PAYSTACK_SUBSCRIPTION_URL=https://paystack.shop/pay/dd0j72-9kt
VITE_PAYSTACK_SUBSCRIPTION_PLAN_CODE=PLN_aoo1xazr02olbru
# Worker-side recurring plan configuration. The plan code/amount must match
# the Paystack plan; Paystack remains authoritative for actual charges/status.
PAYSTACK_SUBSCRIPTION_PLAN_CODE=PLN_aoo1xazr02olbru
BUYER_SUBSCRIPTION_AMOUNT_CENTS=120000
BUYER_SUBSCRIPTION_INTERVAL=monthly
# Local image-to-text model. Keep the proxy token in the user environment or
# Cloudflare Worker secrets; never commit it here.
LOCAL_VISION_URL=http://127.0.0.1:11436/api/generate
LOCAL_VISION_MODEL=qwen3-vl:8b
# Worker secrets/configuration:
# wrangler secret put SESSION_SECRET
# AUTH_JWKS_URL=https://dev-irn8jgmlsiudjo2l.us.auth0.com/.well-known/jwks.json
# AUTH_ISSUER=https://dev-irn8jgmlsiudjo2l.us.auth0.com/
# AUTH_USERINFO_URL=https://dev-irn8jgmlsiudjo2l.us.auth0.com/userinfo # optional; derived from AUTH_ISSUER
# AUTH_AUDIENCE=https://api.veldarchive.example
# AUTH_ROLES_CLAIM=https://veldarchive.example/roles
# AUTH_PROVIDER=both
# SUPABASE_URL=https://replace-with-project.supabase.co
# SUPABASE_JWT_SECRET=store-with-wrangler-secret-put-when-using-legacy-hs256-signing
# SUPABASE_ISSUER=https://replace-with-project.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://replace-with-project.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_AUDIENCE=authenticated
# SUPABASE_ROLES_CLAIM=app_metadata.roles
# AUTH_ALLOW_ORG_PROVISIONING=false
# TRENDING_SEARCH_MIN_COUNT=3 # application enforces a minimum of 3
# Set only after live production verification:
# EDGE_CONTROLS_ATTESTED_AT=2026-08-16T00:00:00Z
# KEY_ROTATION_ATTESTED_AT=2026-08-16T00:00:00Z
# BACKUP_RESTORE_ATTESTED_AT=2026-08-16T00:00:00Z
# Auth provider self-service portal for email verification, password reset, and MFA.
# AUTH_ACCOUNT_PORTAL_URL=https://your-idp.example/account
# Cloudflare Stream direct uploads (store STREAM_API_TOKEN as a Worker secret).
# STREAM_ACCOUNT_ID=your-cloudflare-account-id
# STREAM_ALLOWED_ORIGINS=https://app.example.com
# Image delivery uses the IMAGES Worker binding configured in wrangler.jsonc.
# wrangler secret put PAYMENT_WEBHOOK_SECRET
# wrangler secret put PAYMENT_TOKEN
# wrangler secret put MEDIA_SCANNER_SECRET
# ALLOWED_ORIGINS=https://app.example.com
# AUTH_ISSUER=https://idp.example.com/
# AUTH_AUDIENCE=veld-archive
# AUTH_ALLOW_ORG_PROVISIONING=false
# PAYMENT_PROVIDER=paystack
# PAYMENT_ENDPOINT=https://api.paystack.co/transaction/initialize
# PAYSTACK_SUBSCRIPTION_PLAN_CODE=PLN_aoo1xazr02olbru
# PAYSTACK_SUBSCRIPTION_AMOUNT_CENTS=120000
# PAYSTACK_SUBSCRIPTION_CURRENCY=ZAR
# MEDIA_SCANNER_URL=https://scanner.example.com/scan
# Set as a Worker secret, never in this file:
# wrangler secret put TURNSTILE_SECRET
# Optional provider secrets/configuration:
# Didit API key and webhook secret are Worker secrets. Create separate KYC and
# KYB workflows in the Didit Console and set their stable workflow IDs below.
# wrangler secret put DIDIT_API_KEY
# The deployed naming convention may use DIDIT_SIGNING_SECRET instead.
# wrangler secret put DIDIT_WEBHOOK_SECRET
# wrangler secret put DIDIT_SIGNING_SECRET
# DIDIT_KYC_WORKFLOW_ID=replace-with-didit-kyc-workflow-uuid
# DIDIT_KYB_WORKFLOW_ID=replace-with-didit-kyb-workflow-uuid
# APP_PUBLIC_URL=https://app.example.com
# CIPC_LOOKUP_URL=https://your-authoritative-cipc-adapter.example/lookup
# wrangler secret put CIPC_LOOKUP_TOKEN
# wrangler secret put STRIPE_SECRET_KEY
# wrangler secret put PAYFAST_TOKEN
# wrangler secret put ZA_BANK_TOKEN
# wrangler secret put FIRMA_API_TOKEN
# PAYSTACK_PUBLIC_KEY=replace-with-paystack-public-key
# Store the Paystack secret as PAYMENT_TOKEN with `wrangler secret put PAYMENT_TOKEN`.
# ZA_BANK_ENDPOINT=https://your-bank-adapter.example/payouts
# FIRMA_VERIFY_URL=https://your-firma-adapter.example/verify
# Zoho ecosystem integrations. Keep client secrets, refresh tokens, and Flow
# webhook URLs in Worker secrets; do not put them in Vite/browser variables.
# Zoho Social and Zoho Desk use Zoho Flow webhooks so brand/department
# permissions remain managed inside Zoho and CMS publishing remains reviewable.
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_CLIENT_ID=your-zoho-client-id
# ZOHO_CLIENT_SECRET=store-with-wrangler-secret-put
# ZOHO_OAUTH_SCOPES=ZohoCRM.modules.ALL,ZohoCRM.settings.modules.READ,ZohoCRM.settings.fields.READ
# ZOHO_REFRESH_TOKEN=store-with-wrangler-secret-put
# ZOHO_API_DOMAIN=https://www.zohoapis.com
# ZOHO_CRM_MODULE=Campaigns
# ZOHO_CRM_EXTERNAL_FIELD=Veld_Archive_ID
# ZOHO_CRM_NAME_FIELD=Campaign_Name
# ZOHO_CRM_DESCRIPTION_FIELD=Description
# Optional custom CRM fields. Leave unset to omit the corresponding field
# rather than sending a field name that does not exist in the target module.
# ZOHO_CRM_STATUS_FIELD=Status
# ZOHO_CRM_APPROVED_ASSETS_FIELD=Veld_Archive_Approved_Assets
# ZOHO_CRM_PLATFORMS_FIELD=Veld_Archive_Platforms
# ZOHO_CRM_USAGE_RIGHTS_FIELD=Veld_Archive_Usage_Rights
# ZOHO_CRM_URL_FIELD=Veld_Archive_URL
# ZOHO_SOCIAL_FLOW_WEBHOOK_URL=store-with-wrangler-secret-put
# ZOHO_DESK_FLOW_WEBHOOK_URL=store-with-wrangler-secret-put
# ZOHO_CAMPAIGNS_FLOW_WEBHOOK_URL=store-with-wrangler-secret-put
# ZOHO_ANALYTICS_FLOW_WEBHOOK_URL=store-with-wrangler-secret-put
# ZOHO_TOKEN_ENCRYPTION_KEY=store-with-wrangler-secret-put
